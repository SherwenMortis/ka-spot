# Tests & Temporary / Planning Files
# Contents are excluded rather than the directory itself: a trailing-slash rule
# on `/test/` also blocks the re-inclusion below.
/test/*
# The privacy suite asserts published legal text, so it is kept in version
# control next to the policy content it reviews. The account-deletion and
# notification suites cover the flows that text makes promises about, so they
# belong next to it for the same reason. The backend-target suite guards the
# staging build from silently resolving to production.
!/test/privacy_policy_ui_test.dart
!/test/account_deletion_test.dart
!/test/notification_privacy_test.dart
!/test/backend_target_test.dart
plan.md
TODO.md
assets/logos/preview.html
assets/logos/logo_*.svg


Supabase Pass.txt
client_secret*.json
*client_secret*.json
*.apps.googleusercontent.com.json

# Firebase service account key (contains private key — never commit)
*firebase-adminsdk*.json

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
.vscode/
supabase/.temp/

# Firebase / Google platform config files (contain API keys)
# These are placed in android/app/ and ios/Runner/ at build time.
# Add them back explicitly if your CI pipeline needs them.
*google-services*.json
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Live Realtime check artifacts: throwaway sign-in credentials and the SQL the
# account script generates for them. Never commit these.
tool/*.accounts
supabase/tmp_*.sql
