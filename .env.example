# KaSpot Environment Configuration Template
# Copy this file to .env and configure your Supabase project keys:
# cp .env.example .env

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Build-time backend declaration. `--dart-define` WINS over this file, so a
# staging build cannot inherit these values by accident. Declaring the backend is
# what makes `KASPOT_ACCOUNT_DELETION` effective at all: an undeclared build
# never offers in-app deletion, even if it asks for it.
#   KASPOT_BACKEND=staging|production
#   KASPOT_ACCOUNT_DELETION=true
# The production project ref is hard-coded in lib/utils/backend_config.dart, and a
# build that declares staging while pointing at it refuses to start.

# Development-only local preview session (fabricated local user, no server
# verification). Never enable in release builds.
# KASPOT_LOCAL_PREVIEW=true

# Staging configuration (required before account deletion is enabled in a build):
# a test build must point at a separate Supabase project, never the live one.
#   SUPABASE_URL=https://<staging-project-ref>.supabase.co
#   SUPABASE_ANON_KEY=<staging publishable key>
# Deploy both Edge Functions and apply the migrations to that project only. The
# delete-account function deletes the account behind the token it is called with,
# so a test build pointed at production deletes real accounts.
#
# The same variable names are used by tool/live_check_env.ps1, which additionally
# requires KASPOT_PROJECT_REF to equal the ref in this URL and refuses the
# production project unless KASPOT_ALLOW_PRODUCTION=1.
